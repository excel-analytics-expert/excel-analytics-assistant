generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support; roles/methods are validated in the application layer.
// StaffRole: "LEADER" | "MEMBER"
// ClockMethod: "QR" | "MANUAL"

model Staff {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  role      String   @default("MEMBER")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  assignments      ShiftAssignment[]
  attendances      Attendance[]
  incidentReports  IncidentReport[]
}

model Site {
  id                String   @id @default(cuid())
  name              String
  address           String?
  requiredHeadcount Int      @default(1)
  defaultStartTime  String   @default("09:00")
  defaultEndTime    String   @default("17:00")
  createdAt         DateTime @default(now())

  shifts    Shift[]
  qrTokens  DailyQrToken[]
}

model Shift {
  id        String   @id @default(cuid())
  siteId    String
  date      String   // "YYYY-MM-DD"
  startTime String   // "09:00"
  endTime   String   // "17:00"
  createdAt DateTime @default(now())

  site            Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assignments     ShiftAssignment[]
  attendances     Attendance[]
  incidentReports IncidentReport[]

  @@index([siteId, date])
  @@index([date])
}

model ShiftAssignment {
  id       String @id @default(cuid())
  shiftId  String
  staffId  String

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([shiftId, staffId])
  @@index([staffId])
}

model Attendance {
  id                String    @id @default(cuid())
  shiftId           String
  staffId           String
  clockIn           DateTime?
  clockOut          DateTime?
  clockInMethod     String?
  clockOutMethod    String?
  // 本人確認用に撮影した写真（スマホを持たないスタッフは共有端末で撮影）。ファイル名のみ保持し、実体は非公開ディレクトリに保存。
  clockInPhotoPath  String?
  clockOutPhotoPath String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([shiftId, staffId])
}

// リーダー・本社への申し送り事項やトラブル報告。出退勤とは独立していつでも投稿できる。
model IncidentReport {
  id        String   @id @default(cuid())
  shiftId   String
  staffId   String
  message   String
  photoPath String?
  createdAt DateTime @default(now())

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([shiftId])
}

model DailyQrToken {
  id        String   @id @default(cuid())
  siteId    String
  date      String   // "YYYY-MM-DD"
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, date])
}
